Options -Indexes

DirectoryIndex index.html

# Security / crawler basics
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Cache static assets for better Core Web Vitals
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/jpeg "access plus 90 days"
  ExpiresByType image/png "access plus 90 days"
  ExpiresByType image/webp "access plus 90 days"
  ExpiresByType image/svg+xml "access plus 90 days"
  ExpiresByType image/x-icon "access plus 90 days"
  ExpiresByType application/manifest+json "access plus 7 days"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Prefer HTTPS when available on the host
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} ^(www\.)?redeemysoul\.com$ [NC]
  RewriteRule ^ https://redeemysoul.com%{REQUEST_URI} [L,R=301]

  # Canonical host without www
  RewriteCond %{HTTP_HOST} ^www\.redeemysoul\.com$ [NC]
  RewriteRule ^ https://redeemysoul.com%{REQUEST_URI} [L,R=301]

  # Serve pretty routes from their .html counterparts
  RewriteRule ^begin/?$ /begin/index.html [L]
  RewriteRule ^track/?$ /track/index.html [L]
  RewriteRule ^admin/?$ /admin/index.html [L]
  RewriteRule ^topics/?$ /topics/index.html [L]
  RewriteRule ^topics/([a-z0-9-]+)/?$ /topics/$1/index.html [L]

  # If a directory is requested and index.html exists, use it
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]
</IfModule>
